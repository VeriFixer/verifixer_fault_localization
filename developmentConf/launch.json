    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            // Set CWD to the project's root folder (the one containing 'src')
            "cwd": "${workspaceFolder}", 
            
            // This is CRITICAL for 'src' layouts: 
            // Add the parent of the package (the 'src' directory) to the path
            // This allows the import 'from fl_eval...' to work.
            "env": {
                "PYTHONPATH": "${workspaceFolder}${pathSeparator}src"
            },
            "console": "integratedTerminal"
        },
        {
            "name": ".NET Core Launch (Console)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            // Path to the DLL. 'net6.0' should match your TargetFramework in .csproj
            "program": "${workspaceFolder}/strategies/ReturnAtRandomAllLinesOfFailingMethod/bin/Debug/net8.0/ReturnAtRandomAllLinesOfFailingMethod.dll",
            "args": [
                "/home/ricostynha/Desktop/verifixer_fault_localization/src/pos_mutation/killed/abs__121-127_COI.dfy"
            ],
            "cwd": "${workspaceFolder}/strategies/ReturnAtRandomAllLinesOfFailingMethod",
            "console": "integratedTerminal",
            "stopAtEntry": false
        }
    ]
}

