#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

IMAGE_TAG="dafny_research:latest"

if ! command -v docker >/dev/null 2>&1; then
  echo "[pre-push] docker is required but was not found in PATH." >&2
  exit 1
fi

echo "[pre-push] Building Docker image: ${IMAGE_TAG}"
docker build -t "${IMAGE_TAG}" .

echo "[pre-push] Running repository health check inside container"
docker run --rm -w /app "${IMAGE_TAG}" \
  python src/run_repo_health_check.py --clean-cache

echo "[pre-push] All checks passed. Push allowed."
